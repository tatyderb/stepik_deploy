      "type": "StepGennumber",
      "header": "Простая задача",
      "skip": false,
      "data": {
        "stepSource": {
          "block": {
            "text": "<p><img alt=\"Картинка со шмелём\" src=\"https://stepik.org/media/attachments/lesson/2330913/%D0%BC%D0%B8%D0%BB%D1%8B%D0%B9_%D1%88%D0%BC%D0%B5%D0%BB%D1%8C.jpeg\" /></p>",
            "name": "random-tasks",
            "source": {
